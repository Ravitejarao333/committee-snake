{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cheap-thrills",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One Worker serves the client and the API (ADR 0006). Build the client first.
  // The Worker runs only for these routes; everything else is a static asset, and
  // unknown paths fall back to index.html. "/room" is listed for POST /room,
  // which "/room/*" does not match.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/room", "/room/*", "/public/*", "/health"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" }
    ]
  },
  // SQLite-backed DOs are the kind that work on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "LobbyDO"] }],
  "vars": { "ENVIRONMENT": "development" },
  "env": {
    // Named explicitly so the URL is cheap-thrills.<subdomain>.workers.dev rather
    // than cheap-thrills-production. Bindings and vars are not inherited by
    // environments, so durable_objects is repeated here (migrations are top-level).
    // The old committee-snake Worker now only redirects (wrangler.redirect.jsonc).
    "production": {
      "name": "cheap-thrills",
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDO" },
          { "name": "LOBBY", "class_name": "LobbyDO" }
        ]
      },
      "vars": { "ENVIRONMENT": "production" }
    }
  }
}
