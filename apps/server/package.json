{
  "name": "@committee-snake/server",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker + Durable Objects: one Room DO per snake, one Lobby DO for public matchmaking.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @committee-snake/client build && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc -p tsconfig.json",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@committee-snake/shared": "workspace:*"
  },
  "devDependencies": {
    "@committee-snake/client": "workspace:*",
    "@cloudflare/workers-types": "^5.20261022.1",
    "wrangler": "^4.152.0"
  }
}
