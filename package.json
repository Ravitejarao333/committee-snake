{
  "name": "committee-snake",
  "version": "0.2.0",
  "private": true,
  "description": "Classic phone Snake, except everyone in the room votes on where it turns. Democracy was a mistake.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky",
    "replay": "node --experimental-strip-types scripts/replay.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  }
}
